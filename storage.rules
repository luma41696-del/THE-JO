rules_version = '2';

// ============================================================================
// net sale | نت سيل — Cloud Storage Security Rules
//
// Two rules do most of the work here:
//   1. Product imagery is world-readable and staff-writable.
//   2. Nothing anywhere accepts an SVG upload.
//
// The second is not paranoia. An SVG is an executable document: it can carry
// <script>, and if it is served from your own origin a stored XSS follows. The
// storefront already renders trusted SVG through `next/image`, which is why
// `next.config.ts` sets `dangerouslyAllowSVG` — that flag is only safe because
// customer-supplied files can never reach the same path.
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    /* ---------------------------------------------------------------- */
    /*  Helpers                                                          */
    /* ---------------------------------------------------------------- */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isStaff() {
      return isSignedIn()
        && (request.auth.token.role == 'staff' || request.auth.token.role == 'admin');
    }

    // Raster only. SVG, HTML and anything else is rejected by omission.
    function isSafeImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|avif|gif)');
    }

    function underSize(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    /* ---------------------------------------------------------------- */
    /*  Product imagery — public read                                    */
    /* ---------------------------------------------------------------- */

    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write: if isStaff() && isSafeImage() && underSize(10);
    }

    match /banners/{fileName} {
      allow read: if true;
      allow write: if isStaff() && isSafeImage() && underSize(10);
    }

    match /categories/{fileName} {
      allow read: if true;
      allow write: if isStaff() && isSafeImage() && underSize(10);
    }

    /* ---------------------------------------------------------------- */
    /*  Review photos — public read, owner write                         */
    /* ---------------------------------------------------------------- */

    // Published next to the review by design, so world-readable. Written only
    // into the author's own folder: a shared folder would let any signed-in
    // shopper overwrite somebody else's photo. Smaller than product imagery
    // because nobody needs a 10MB snapshot of a jumper, and every one of these
    // is a file a stranger uploaded.
    match /reviews/{uid}/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid) && isSafeImage() && underSize(5);
      allow delete: if isOwner(uid) || isStaff();
    }

    /* ---------------------------------------------------------------- */
    /*  Customer uploads — private to their owner                        */
    /* ---------------------------------------------------------------- */

    match /users/{uid}/avatar/{fileName} {
      // Avatars are shown in the customer's own account UI only.
      allow read: if isOwner(uid) || isStaff();
      allow write: if isOwner(uid) && isSafeImage() && underSize(4);
      allow delete: if isOwner(uid);
    }

    // Fitting-room body photos. The most sensitive data the store touches:
    // never public, never readable by staff, and deletable by their owner at
    // any time. If a try-on pipeline needs them, it reads them with the Admin
    // SDK inside a Cloud Function — not from a signed URL handed to a browser.
    match /users/{uid}/fitting/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isSafeImage() && underSize(8);
      allow delete: if isOwner(uid);
    }

    /* ---------------------------------------------------------------- */
    /*  Default deny                                                     */
    /* ---------------------------------------------------------------- */

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
