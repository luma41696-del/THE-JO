# ---------------------------------------------------------------------------
# THE JO | ذاجو — environment template
# Copy to `.env.local` and fill in. `.env.local` is git-ignored. Never commit it.
# ---------------------------------------------------------------------------

# --- Firebase Web SDK (client) ---------------------------------------------
# These NEXT_PUBLIC_* values are shipped to the browser by design. They are
# public *identifiers*, not credentials — your data is protected by Firestore
# Security Rules and App Check, never by hiding these. Still kept in env so the
# same codebase can point at dev / staging / prod projects.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SIGN_IN_ENABLED=false

# --- Firebase App Check (reCAPTCHA Enterprise site key) --------------------
# Public site key. Blocks unauthenticated abuse of Firestore/Storage/Functions.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Local dev only: paste the debug token printed in the browser console.
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=

# --- Firebase Admin SDK (SERVER ONLY — real secrets, never NEXT_PUBLIC_) ---
# Generate: Firebase console > Project settings > Service accounts.
# Paste the private key with literal \n escapes, wrapped in double quotes.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=""


# ---------------------------------------------------------------------------
# Payments
#
# There are none to configure. The shop takes cash on delivery only, and
# `src/lib/payments.ts` is the one list that governs both what the checkout
# offers and what the server accepts.
#
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET and NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
# used to sit here. They were removed rather than left blank: they implied a
# chosen provider and a half-built integration, and neither was true. What a
# real gateway needs — merchant account first, PCI scope, webhook-confirms-not-
# the-browser — is written out in PAYMENTS.md.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Order notifications (optional)
#
# Without these the shop still works: every notification is recorded with the
# state "skipped" and the admin says so on the order, rather than pretending a
# message went out. Set all three to switch them on.
#
#   NOTIFY_PROVIDER  currently only "resend"
#   NOTIFY_API_KEY   the provider's secret key — server-side only, never
#                    NEXT_PUBLIC_, or it ships to every browser
#   NOTIFY_FROM      a From address on a domain verified with the provider
# ---------------------------------------------------------------------------
NOTIFY_PROVIDER=
NOTIFY_API_KEY=
NOTIFY_FROM=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=JOD

# Development only: open /admin without a signed-in account. Next inlines
# NODE_ENV at build time, so this branch is dead code in production.
NEXT_PUBLIC_ADMIN_DEV_BYPASS=false
