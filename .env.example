# ---------------------------------------------------------------------------
# THE JO | ذاجو — environment template
# Copy to `.env.local` and fill in. `.env.local` is git-ignored. Never commit it.
# ---------------------------------------------------------------------------

# --- Firebase Web SDK (client) ---------------------------------------------
# These NEXT_PUBLIC_* values are shipped to the browser by design. They are
# public *identifiers*, not credentials — your data is protected by Firestore
# Security Rules and App Check, never by hiding these. Still kept in env so the
# same codebase can point at dev / staging / prod projects.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SIGN_IN_ENABLED=false

# --- Firebase App Check (reCAPTCHA Enterprise site key) --------------------
# Public site key. Blocks unauthenticated abuse of Firestore/Storage/Functions.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Local dev only: paste the debug token printed in the browser console.
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=

# --- Firebase Admin SDK (SERVER ONLY — real secrets, never NEXT_PUBLIC_) ---
# Generate: Firebase console > Project settings > Service accounts.
# Paste the private key with literal \n escapes, wrapped in double quotes.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=""


# ---------------------------------------------------------------------------
# Payments
#
# There are none to configure. The shop takes cash on delivery only, and
# `src/lib/payments.ts` is the one list that governs both what the checkout
# offers and what the server accepts.
#
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET and NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
# used to sit here. They were removed rather than left blank: they implied a
# chosen provider and a half-built integration, and neither was true. What a
# real gateway needs — merchant account first, PCI scope, webhook-confirms-not-
# the-browser — is written out in PAYMENTS.md.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Order notifications (optional)
#
# Without these the shop still works: every notification is recorded with the
# state "skipped" and the admin says so on the order, rather than pretending a
# message went out. Set all three to switch them on.
#
#   NOTIFY_PROVIDER  currently only "resend"
#   NOTIFY_API_KEY   the provider's secret key — server-side only, never
#                    NEXT_PUBLIC_, or it ships to every browser
#   NOTIFY_FROM      a From address on a domain verified with the provider
#
# These three also send the branded account-confirmation email. Until they are
# set, sign-up falls back to Firebase's own plain message — so the flow always
# works, it just does not look like the shop.
#
# ## DNS, and one way to get it badly wrong
#
# netsale.shop currently publishes:
#
#   TXT    v=spf1 include:_spf.firebasemail.com ~all     (Firebase only)
#   _dmarc v=DMARC1; p=quarantine; adkim=r; aspf=r; ...
#
# DMARC is at **p=quarantine**, so mail that fails alignment is not merely
# marked — it goes to spam. Sending through Resend from @netsale.shop fails
# SPF today, because that record authorises Firebase and nothing else.
#
# **Do not add a second TXT record starting with v=spf1.** A domain with two
# SPF records is a permanent error and breaks *all* of its mail, Firebase's
# included. Verify a subdomain in Resend instead, which leaves the existing
# record untouched:
#
#   send.netsale.shop                  MX    feedback-smtp.<region>.amazonses.com  (10)
#   send.netsale.shop                  TXT   v=spf1 include:amazonses.com ~all
#   resend._domainkey.send.netsale.shop TXT  (the DKIM key Resend generates)
#
# Then NOTIFY_FROM="Net Sale <no-reply@send.netsale.shop>". The apex DMARC uses
# relaxed alignment, so a subdomain still aligns with netsale.shop.
# ---------------------------------------------------------------------------
NOTIFY_PROVIDER=
NOTIFY_API_KEY=
NOTIFY_FROM=

# ---------------------------------------------------------------------------
# Virtual try-on — Google Vertex AI  (optional)
#
# Generates a photorealistic image of the customer wearing a garment. Costs
# roughly USD 0.04–0.10 per image and takes 5–20 seconds, so it runs as a job.
# Leave these empty and the fitting room says the feature is not connected —
# it never shows a fabricated result.
#
#   VTO_PROVIDER              "vertex-vto", or empty for off
#   VTO_PROJECT_ID            the Google Cloud project with Vertex AI enabled
#   VTO_LOCATION              the region the model is served from; Virtual
#                             Try-On is region-restricted
#   VTO_SERVICE_ACCOUNT_JSON  the whole service-account JSON, on one line.
#                             Server-side only — never NEXT_PUBLIC_, and never
#                             committed. An API key does not work here: Vertex
#                             `:predict` needs an OAuth token, which is why
#                             there is no VTO_API_KEY any more.
# ---------------------------------------------------------------------------
VTO_PROVIDER=
VTO_PROJECT_ID=
VTO_LOCATION=
VTO_SERVICE_ACCOUNT_JSON=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=JOD

# Development only: open /admin without a signed-in account. Next inlines
# NODE_ENV at build time, so this branch is dead code in production.
NEXT_PUBLIC_ADMIN_DEV_BYPASS=false

# ---------------------------------------------------------------------------
# Google Sheets import (optional)
# ---------------------------------------------------------------------------
# Left empty on purpose, and the feature works without it.
#
# A sheet shared with "anyone with the link" is readable by URL alone, which is
# the case a merchant pasting a link to their own stock sheet is in. A key is
# only needed for sheets that stay private, and the server reads this one if it
# is set rather than requiring it — so an unset value degrades to "that sheet is
# not shared" with instructions, not to a broken button.
#
# Never commit a real value here.
GOOGLE_SHEETS_API_KEY=

# ---------------------------------------------------------------------------
# Sign-in providers
# ---------------------------------------------------------------------------
# Both are built and both are off until switched on here, because a sign-in
# button that cannot sign anybody in is worse than no button: the customer
# blames themselves, tries again, and leaves.
#
# Neither flag does anything on its own. The provider has to be enabled in the
# Firebase console first (Authentication -> Sign-in method), and the live
# domain added under Authentication -> Settings -> Authorized domains.
NEXT_PUBLIC_GOOGLE_SIGN_IN_ENABLED=false

# Phone sign-in SENDS SMS, AND SMS COSTS MONEY. Firebase gives a small free
# daily allowance and bills per message after it — and unlike every other
# provider here, a stranger with a loop can run that bill up. Leave this off
# until the Blaze plan, an SMS budget and the console's own abuse protection
# are all deliberately in place. The shop's rate limit sits in front of it too.
NEXT_PUBLIC_PHONE_SIGN_IN_ENABLED=false