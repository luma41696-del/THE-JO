{
  "name": "net-sale",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:firebase-runtime": "node --no-experimental-require-module --test scripts/firebase-runtime.test.cjs",
    "seed": "tsx scripts/seed.ts",
    "dev:turbo": "next dev --turbopack -p 3000",
    "brand": "node scripts/generate-brand.mjs",
    "rules:deploy": "firebase deploy --only firestore,storage",
    "emulators": "firebase emulators:start",
    "grant-admin": "tsx scripts/grant-admin.ts",
    "test:offers": "tsx --test scripts/offers.test.ts",
    "test": "npm run test:offers && npm run test:visibility && npm run test:phase3 && npm run test:phase4 && npm run test:designs && npm run test:zones && npm run test:invoice && npm run test:notify && npm run test:payments && npm run test:errors && npm run test:privacy && npm run test:firebase-runtime && npm run test:product-save",
    "test:product-save": "node --test scripts/product-save.test.cjs",
    "test:visibility": "tsx --test scripts/visibility.test.ts",
    "test:phase3": "tsx --test scripts/phase3.test.ts",
    "test:privacy": "tsx --test scripts/analytics-privacy.test.ts",
    "test:phase4": "tsx --test scripts/phase4.test.ts",
    "test:designs": "tsx --test scripts/designs.test.ts",
    "test:zones": "tsx --test scripts/zones.test.ts",
    "test:invoice": "tsx --test scripts/invoice.test.ts",
    "test:notify": "tsx --test scripts/notify.test.ts",
    "test:payments": "tsx --test scripts/payments.test.ts",
    "test:rules:run": "tsx --test scripts/rules.test.ts",
    "test:rules": "firebase emulators:exec --only firestore \"npm run test:rules:run\"",
    "test:storage-rules:run": "tsx --test scripts/storage-rules.test.ts",
    "test:storage-rules": "firebase emulators:exec --only storage \"npm run test:storage-rules:run\"",
    "test:errors": "tsx --test scripts/errors.test.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "firebase": "^12.0.0",
    "firebase-admin": "^14.4.0",
    "lottie-react": "^2.4.1",
    "motion": "^12.0.0",
    "next": "^15.5.0",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.0",
    "three": "^0.186.0",
    "zustand": "^5.0.3"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "5.10.0"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0"
  }
}
